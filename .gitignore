# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Outils
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Données brutes et produites (hors Git : lien Kaggle + checksum)
data/raw/*
!data/raw/.gitkeep
!data/raw/CHECKSUMS.txt
# Données de la simulation en direct, lues chaque nuit par GitHub Actions
!data/raw/XAU_1d_data.csv
!data/raw/XAU_1d_gapfill.csv
!data/raw/XAU_1d_update.csv
data/processed/*
!data/processed/.gitkeep

# Sorties générées
outputs/models/*
!outputs/models/.gitkeep
# Modèles figés de la simulation en direct : leurs SHA-256 sont scellés dans le genèse
!outputs/models/live/
outputs/results/*
!outputs/results/.gitkeep
outputs/eda/
# Registres des backtests : versionnés seulement au rendu final (phase 7, §8.3)
outputs/ledger/*.jsonl
mlruns/

# Secrets : la clé privée du registre ne doit jamais être versionnée
*.key
*private*.pem
.env

# Divers
.DS_Store
.idea/
.vscode/
keys/
# Réglages figés : ancrés sur Sepolia, versionnés comme preuve (toutes les versions).
!outputs/ledger/reglages_figes*.jsonl
outputs/live_daily.log
